# ==============================================================================
# UNIVERSAL CERTIFICATE STUDIO — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in the same folder and customize values for your setup.
# In PowerShell: Copy-Item .env.example .env
# In Bash:       cp .env.example .env
# ==============================================================================

# Application Branding
PROJECT_NAME="Universal Certificate Studio API"
API_V1_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# DATABASE CONNECTION
# ------------------------------------------------------------------------------
# 1. LOCAL SQLITE (Default, no setup required):
DATABASE_URL="sqlite:///./certificates.db"

# 2. MYSQL DATABASE (Production / Shared Team Database):
# Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?charset=utf8mb4
# Example:
# DATABASE_URL="mysql+pymysql://root:password123@localhost:3306/certificate_studio?charset=utf8mb4"

# ------------------------------------------------------------------------------
# ORGANIZER SECURITY & PASSKEY
# ------------------------------------------------------------------------------
# The master administrative passkey required to unlock the Certificate Studio
# and execute batch generation requests. Change this to a secure secret.
ADMIN_SECRET_KEY="zap10x-admin-2026"

# ------------------------------------------------------------------------------
# PUBLIC VERIFICATION URL TEMPLATE
# ------------------------------------------------------------------------------
# This base URL is embedded into every generated QR code.
# When scanned by a phone, it redirects the student to the verification portal.
# - Local Development:
VERIFICATION_BASE_URL="http://localhost:5173/verify?id="
# - Production Example:
# VERIFICATION_BASE_URL="https://credentials.yourdomain.com/verify?id="
